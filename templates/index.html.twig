{% extends 'base.html.twig' %}

{% block title %}Dashboard — FinanTech{% endblock %}

{% block body %}

    <div class="container-xl py-5">

        {# ── Header ── #}
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="fw-bold mb-0" style="font-size: 2rem; letter-spacing: -0.5px;">
                    💰 FinanTech
                </h1>
                <small class="text-muted">Controle Financeiro Pessoal · Junho 2026</small>
            </div>
            <a href="#" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                + Nova Transação
            </a>
        </div>

        {# ── Cards de Resumo ── #}
        <div class="row g-4 mb-5">

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid #198754 !important;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Receitas</p>
                            <h2 class="fw-bold text-success mb-0">R$ 5.250,00</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#198754" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid #dc3545 !important;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Despesas</p>
                            <h2 class="fw-bold text-danger mb-0">R$ 2.180,00</h2>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#dc3545" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0" style="border-left: 4px solid #0d6efd !important;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small fw-semibold text-uppercase mb-1">Saldo Atual</p>
                            <h2 class="fw-bold text-primary mb-0">R$ 3.070,00</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#0d6efd" viewBox="0 0 16 16">
                                <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1H1V3zm0 2h14v9a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5zm5 3a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1H6z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# ── Tabela de Transações ── #}
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">Últimas Transações</h5>
                <a href="#" class="btn btn-sm btn-outline-secondary">Ver todas</a>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted small fw-semibold text-uppercase">Data</th>
                        <th class="py-3 text-muted small fw-semibold text-uppercase">Descrição</th>
                        <th class="py-3 text-muted small fw-semibold text-uppercase">Categoria</th>
                        <th class="pe-4 py-3 text-muted small fw-semibold text-uppercase text-end">Valor</th>
                    </tr>
                    </thead>

                    <tbody>
                    <tr>
                        <td class="ps-4 text-muted small">03/06/2026</td>
                        <td class="fw-semibold">Salário</td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">
                                Receita
                            </span>
                        </td>
                        <td class="pe-4 text-success fw-bold text-end">+ R$ 4.500,00</td>
                    </tr>

                    <tr>
                        <td class="ps-4 text-muted small">02/06/2026</td>
                        <td class="fw-semibold">Mercado</td>
                        <td>
                            <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold px-2 py-1">
                                Alimentação
                            </span>
                        </td>
                        <td class="pe-4 text-danger fw-bold text-end">- R$ 320,00</td>
                    </tr>

                    <tr>
                        <td class="ps-4 text-muted small">01/06/2026</td>
                        <td class="fw-semibold">Internet</td>
                        <td>
                            <span class="badge bg-warning bg-opacity-10 text-warning fw-semibold px-2 py-1">
                                Serviços
                            </span>
                        </td>
                        <td class="pe-4 text-danger fw-bold text-end">- R$ 99,90</td>
                    </tr>

                    <tr>
                        <td class="ps-4 text-muted small">31/05/2026</td>
                        <td class="fw-semibold">Freelance Design</td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">
                                Receita
                            </span>
                        </td>
                        <td class="pe-4 text-success fw-bold text-end">+ R$ 750,00</td>
                    </tr>

                    <tr>
                        <td class="ps-4 text-muted small">30/05/2026</td>
                        <td class="fw-semibold">Combustível</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold px-2 py-1">
                                Transporte
                            </span>
                        </td>
                        <td class="pe-4 text-danger fw-bold text-end">- R$ 180,00</td>
                    </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top text-center py-3">
                <a href="#" class="text-muted small text-decoration-none">Carregar mais transações ↓</a>
            </div>

        </div>

    </div>

{% endblock %}
